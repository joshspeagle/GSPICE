---
// V-1, the mask explainer: drag or resize a masked block over a spectrum, and see the
// prediction of the hidden pixels from the others. The build renders the first frame,
// so the figure shows without JavaScript; the script redraws it on each input.
// docs/scripts/explainers.py writes the data.
import data from '../data/explainer.json'
import { condition } from '../lib/gauss.ts'
import { axesFor, legend, plotMarkup, readout } from '../lib/spectrum-plot.ts'
import '../styles/plot.css'

// The first frame, which the script starts from.
const first = { example: 0, start: 50, width: 20 }
const { flux, truth } = data.examples[first.example]
const { mu, sd } = condition(data.mean, data.cov, flux, first.start, first.width)
const axes = axesFor([...data.examples.flatMap((example) => [...example.flux, ...example.truth]), ...data.band], data.npix)
const spectrum = { flux, start: first.start, width: first.width, mu, sd }
---

<figure class="gs-explainer" data-axes={JSON.stringify(axes)} data-first={JSON.stringify(first)}>
  <p class="gs-hint" id="gs-explainer-hint">
    Drag the grey block, or drag its edges to resize it. With the plot focused, the arrow
    keys move the block, and Shift with an arrow key resizes it.
  </p>
  <div
    class="gs-plot"
    data-npix={data.npix}
    tabindex="0"
    role="group"
    aria-label="Spectrum with a masked block"
    aria-describedby="gs-explainer-hint"
    set:html={plotMarkup(spectrum, axes)}
  />
  <div class="gs-controls">
    <button type="button" data-action="truth" aria-pressed="false">Show flux without noise</button>
    <button type="button" data-action="next">Next spectrum</button>
    <span data-count>Spectrum 1 of {data.examples.length}</span>
  </div>
  <p class="gs-readout" aria-live="polite" data-readout>
    {readout({ ...spectrum, truth })}
  </p>
  <noscript><p class="gs-hint">The block moves only with JavaScript on.</p></noscript>
  <figcaption class="gs-caption">
    <Fragment set:html={legend(['obs', 'pred', 'b1', 'b2', 'truth'])} />
    <p>
      The prediction is that of <code>gspice.infill</code> with a model fitted to {data.ntrain} simulated
      spectra of {data.npix} pixels. The ±1σ and ±2σ bands include the noise of the observed
      flux.
    </p>
  </figcaption>
</figure>

<script>
  import data from '../data/explainer.json'
  import { condition } from '../lib/gauss.ts'
  import { plotMarkup, readout, type Axes } from '../lib/spectrum-plot.ts'

  const npix = data.npix
  const root = document.querySelector<HTMLElement>('.gs-explainer')!
  const axes: Axes = JSON.parse(root.dataset.axes!)
  const plot = root.querySelector<HTMLElement>('.gs-plot')!
  const text = root.querySelector<HTMLElement>('[data-readout]')!
  const count = root.querySelector<HTMLElement>('[data-count]')!
  const truthButton = root.querySelector<HTMLButtonElement>('[data-action="truth"]')!
  const state = { ...JSON.parse(root.dataset.first!), truth: false }
  let frame = 0
  let announce = 0

  function draw() {
    frame = 0
    const { flux, truth } = data.examples[state.example]
    const { mu, sd } = condition(data.mean, data.cov, flux, state.start, state.width)
    const spectrum = { flux, start: state.start, width: state.width, mu, sd }
    plot.innerHTML = plotMarkup(state.truth ? { ...spectrum, truth } : spectrum, axes)
    // The readout is a live region: it changes once the block stops, so that a screen
    // reader does not announce every frame of a drag.
    clearTimeout(announce)
    announce = setTimeout(() => (text.textContent = readout({ ...spectrum, truth })), 300)
    count.textContent = `Spectrum ${state.example + 1} of ${data.examples.length}`
  }
  const schedule = () => (frame ||= requestAnimationFrame(draw))
  // Keeps the block inside the spectrum, from 1 to data.widest pixels wide.
  function place(start: number, width: number) {
    state.width = Math.max(1, Math.min(data.widest, width))
    state.start = Math.max(0, Math.min(npix - state.width, start))
    schedule()
  }

  // The pixel under the pointer, and the edge of the block within 8 px of it, if any. The
  // reach is at most a quarter of the block, so that the middle of a narrow block moves it.
  function position(event: PointerEvent) {
    const box = plot.getBoundingClientRect()
    const x = ((event.clientX - box.left) / box.width) * npix
    const reach = Math.min((8 / box.width) * npix, state.width / 4)
    const edge =
      Math.abs(x - state.start) < reach ? 'start' : Math.abs(x - state.start - state.width) < reach ? 'end' : null
    return { pixel: Math.floor(x), edge }
  }
  let drag: { mode: 'start' | 'end' } | { mode: 'move'; offset: number } | null = null
  plot.addEventListener('pointerdown', (event) => {
    const { pixel, edge } = position(event)
    // Only the main button, and only on the plot, not on its tick labels.
    if (event.button !== 0 || pixel < 0 || pixel >= npix) return
    if (edge) drag = { mode: edge }
    else {
      // A press outside the block moves its centre there.
      if (pixel < state.start || pixel >= state.start + state.width) place(pixel - (state.width >> 1), state.width)
      drag = { mode: 'move', offset: pixel - state.start }
    }
    plot.setPointerCapture(event.pointerId)
  })
  plot.addEventListener('pointermove', (event) => {
    const { pixel, edge } = position(event)
    if (!drag) {
      const inside = pixel >= state.start && pixel < state.start + state.width
      plot.style.cursor = edge ? 'ew-resize' : inside ? 'grab' : 'pointer'
      return
    }
    const p = Math.max(0, Math.min(npix - 1, pixel))
    const end = state.start + state.width
    if (drag.mode === 'start') {
      const start = Math.max(Math.min(p, end - 1), end - data.widest)
      place(start, end - start)
    } else if (drag.mode === 'end') place(state.start, Math.max(p + 1, state.start + 1) - state.start)
    else place(p - drag.offset, state.width)
  })
  const release = () => (drag = null)
  plot.addEventListener('pointerup', release)
  plot.addEventListener('pointercancel', release)
  plot.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return
    event.preventDefault()
    const step = event.key === 'ArrowRight' ? 1 : -1
    if (event.shiftKey) place(state.start, state.width + step)
    else place(state.start + step, state.width)
  })
  truthButton.addEventListener('click', () => {
    state.truth = !state.truth
    truthButton.setAttribute('aria-pressed', String(state.truth))
    schedule()
  })
  root.querySelector('[data-action="next"]')!.addEventListener('click', () => {
    state.example = (state.example + 1) % data.examples.length
    schedule()
  })
</script>

<style>
  .gs-explainer {
    margin: 0;
    padding: 0.875rem 1.125rem 1rem;
    border-top: 3px solid var(--gs-ink);
    background: var(--gs-bg-2);
  }
  .gs-hint {
    margin: 0 0 0.875rem;
    color: var(--gs-ink-2);
    font-size: 0.875rem;
  }
  .gs-plot {
    --gs-plot-height: 15rem;
    margin-bottom: 2.25rem;
    touch-action: pan-y;
    user-select: none;
  }
  .gs-plot:focus-visible {
    outline-offset: 2px;
  }
  .gs-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    color: var(--gs-ink-2);
    font-size: 0.875rem;
  }
  .gs-controls button {
    padding: 0.4375rem 0.75rem;
    border: 0;
    border-inline-start: 3px solid var(--gs-rule-2);
    background: var(--gs-bg-3);
    color: var(--gs-ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .gs-controls button:hover {
    background: var(--gs-rule);
  }
  .gs-controls button[aria-pressed='true'] {
    border-inline-start-color: var(--gs-ink);
    background: var(--gs-rule);
  }
  .gs-readout {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  figcaption {
    padding-top: 0.75rem;
    border-top: 1px solid var(--gs-rule);
  }
  @media (max-width: 30rem) {
    .gs-explainer {
      padding-inline: 0.75rem;
    }
    .gs-plot {
      --gs-plot-height: 12rem;
    }
  }
</style>
