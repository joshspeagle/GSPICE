---
// V-4: one test spectrum of the quickstart, with the masked pixels that infill
// predicted. docs/scripts/explainers.py runs the code of the page and writes the data.
import data from '../data/quickstart.json'
import { legend, plotMarkup, quickstartLegend, quickstartPlot, readout } from '../lib/spectrum-plot.ts'
import '../styles/plot.css'

const { spectrum, axes } = quickstartPlot(data)
---

<figure class="not-content">
  <div class="gs-plot" data-npix={data.flux.length} role="img" aria-label={readout(spectrum)} set:html={plotMarkup(spectrum, axes)} />
  <figcaption class="gs-caption">
    <Fragment set:html={legend(quickstartLegend)} />
    <p>
      The spectrum <code>test.flux[{data.spectrum}]</code> after <code>infill</code>, at a
      signal-to-noise ratio of {data.snr}. {readout(spectrum)} The error is the prediction minus
      the flux without noise.
    </p>
  </figcaption>
</figure>
