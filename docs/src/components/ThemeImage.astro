---
// The figure of each theme: src names the pair <src>-light.svg and <src>-dark.svg in
// src/assets. Lazy loading keeps the browser from fetching the hidden one.
import type { ImageMetadata } from 'astro'

interface Props {
  src: string
  alt: string
  width?: string
  class?: string
}

const files = import.meta.glob<ImageMetadata>('../assets/**/*.svg', {
  eager: true,
  import: 'default',
})
const { src, alt, width, class: className } = Astro.props
const [light, dark] = ['light', 'dark'].map((theme) => {
  const file = files[`../assets/${src}-${theme}.svg`]
  if (!file) throw new Error(`ThemeImage: no file src/assets/${src}-${theme}.svg`)
  return file
})
---

<img class:list={['dark:sl-hidden', className]} src={light.src} alt={alt} width={width} loading="lazy" />
<img class:list={['light:sl-hidden', className]} src={dark.src} alt={alt} width={width} loading="lazy" />
