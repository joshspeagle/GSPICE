---
// Starlight's footer, then the cell strip of the mean spectrum: one cell per pixel,
// lighter where the flux is higher. docs/scripts/logo.py writes strip.json. The footer
// also carries the script of the term cards, which every page needs.
import Default from '@astrojs/starlight/components/Footer.astro'
import strip from '../assets/strip.json'
import TermCards from './TermCards.astro'
---

<Default />
<TermCards />
<div class="gs-strip" aria-hidden="true">
  {strip.map((level) => <i style={`--level: ${Math.round(level * 1000) / 10}%`}></i>)}
</div>

<style>
  .gs-strip {
    display: flex;
    container-type: inline-size;
    height: 0.625rem;
    margin-top: 3rem;
  }
  .gs-strip :global(i) {
    flex: 1;
    background: color-mix(in srgb, var(--gs-strip-hi) var(--level), var(--gs-strip-lo));
  }
  .gs-strip :global(i + i) {
    margin-inline-start: 1px;
  }
  /* A cell keeps its 1 px gap only while it is wider than 4 px: 120 cells of 4 px
     and their 119 gaps take 599 px. */
  @container (max-width: 599px) {
    .gs-strip :global(i + i) {
      margin-inline-start: 0;
    }
  }
</style>
